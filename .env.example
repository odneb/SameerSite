# The one password that opens /login. Required for the dashboard to work.
ADMIN_PASSWORD=

# Optional. Signs session cookies. Any long random string.
# If omitted, a key is derived from ADMIN_PASSWORD, which means changing the
# password signs everyone out.
AUTH_SECRET=

# Set automatically when a Vercel Blob store is connected to the project.
# Without it, content is written to ./.data as JSON, which is what happens
# locally. Production needs this or edits will not survive a deploy.
BLOB_READ_WRITE_TOKEN=

# Optional scene overrides.
# A grayscale depth pass for the hero plate (white = near). Replaces the
# authored depth regions in lib/scene/config.ts.
NEXT_PUBLIC_DEPTH_URL=
# A real gaussian-splat capture in the 32-byte .splat layout. Replaces the
# plate-derived field entirely.
NEXT_PUBLIC_SPLAT_URL=
